PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=replace-with-your-plex-token

# streamable-http serves both /mcp and legacy /sse. Alternatives: sse, stdio.
MCP_TRANSPORT=streamable-http

# The published port is local-only by default. Set a LAN address or 0.0.0.0
# when clients or a reverse proxy connect from another machine.
MCP_BIND_ADDRESS=127.0.0.1
MCP_PUBLISHED_PORT=3001

# Use the address clients connect to, including the port for direct LAN access.
MCP_SERVER_URL=http://localhost:3001
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Enable OAuth before exposing the server publicly.
MCP_OAUTH_ENABLED=false
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=
